AI_PROVIDER=gemini
OPENAI_API_KEY=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
