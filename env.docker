# Snipe-IT (Docker) — copy and adjust for your environment.
# DB_* must match MYSQL_* below. Change passwords before production.

# --------------------------------------------
# Laravel (required by container startup)
# --------------------------------------------
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:Rl9kv4En1zvZNALIU/9VVKN1q9d7/BJXYp4JEoWIwdQ=
APP_URL=http://localhost:8001
APP_TIMEZONE=UTC
APP_LOCALE=en-US

# --------------------------------------------
# App database (Laravel)
# --------------------------------------------
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=snipeit
DB_USERNAME=snipeit
DB_PASSWORD=changeme
DB_PREFIX=null

# --------------------------------------------
# MariaDB container (must match DB_* above)
# --------------------------------------------
MYSQL_DATABASE=snipeit
MYSQL_USER=snipeit
MYSQL_PASSWORD=changeme
MYSQL_ROOT_PASSWORD=changeme_root

# --------------------------------------------
# Mail (avoid SMTP until configured)
# --------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDR=snipeit@example.com
MAIL_FROM_NAME=Snipe-IT

# --------------------------------------------
# Optional: floating AI assistant
