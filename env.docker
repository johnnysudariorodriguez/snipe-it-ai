# --- Azure / TLS-terminated proxy (set when deploying behind ingress) ---
# APP_URL=https://your-snipe-hostname
# APP_TRUSTED_PROXIES=*
# Optional: change POST path for Application Gateway rules (keep widget + route in sync):
# AI_CHAT_HTTP_URI=api/v1/ai-chat/message
